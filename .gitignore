# =============================================================================
# .gitignore for a Python 3.12 Flask project (VS Code, Windows + macOS)
# =============================================================================

# ---- Virtual environments ----
# Local Python environments are machine-specific and can be rebuilt from requirements.txt.
.venv/
.venv*/
venv/
venv*/
env/
ENV/

# ---- Python bytecode and caches ----
# Compiled files and tool caches are regenerated automatically on every run.
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/

# ---- Test and coverage output ----
# Test caches and coverage reports are build output, not source.
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# ---- Environment variables and secrets ----
# Real .env files hold secrets, so ignore them all but keep the .env.example template tracked.
.env
.env.*
!.env.example

# ---- SQLite databases ----
# Local database files (and their journal/WAL side files) are runtime data, not source.
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*

# ---- Flask instance folder ----
# Flask's instance/ folder holds local config and databases that differ per machine.
instance/

# ---- Logs ----
# Log files grow without limit and can contain sensitive data.
*.log
*.log.*
logs/

# ---- Docker local overrides ----
# Override files hold per-developer Compose settings and should not be shared.
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# ---- Build and packaging output ----
# Generated by pip/setuptools when building or installing the project.
build/
dist/
*.egg-info/

# ---- VS Code settings ----
# Ignore personal editor settings but keep the shared extension recommendations.
# (.vscode/* with a star, not .vscode/, so the ! exception below can work.)
.vscode/*
!.vscode/extensions.json

# ---- Operating-system junk ----
# Files that Windows and macOS create automatically in folders.
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
